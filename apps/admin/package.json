{
  "name": "@cpe/admin",
  "version": "0.0.0",
  "private": true,
  "description": "Circular Paper Economy — internal ops/support/finance/QC dashboard",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "clean": "rm -rf .next out *.tsbuildinfo",
    "lint": "eslint . --max-warnings=0",

{
  "extends": "./tsconfig.json",
  // `prisma` is excluded here even though tsconfig.json includes it (so that the seed
  // script still gets typechecked and linted). If it were compiled, tsc's inferred
  // rootDir would widen from `src/` to `apps/api/`, and the entrypoint would silently
  // move from `dist/main.js` to `dist/src/main.js` — breaking the Dockerfile's CMD.
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma",
    "scripts",
    "**/*.spec.ts",
    "**/*.e2e-spec.ts"
  ]
}

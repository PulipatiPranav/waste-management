# Copy to .env and adjust. NEVER commit .env — only this .example file.
# Every variable here is declared in src/config/env.schema.ts; the API refuses to
# boot if one is missing or malformed.

NODE_ENV=development
PORT=3000
API_PREFIX=/api

# Comma-separated list of browser origins allowed to call this API.
# 3001 is the admin dashboard's local port.
CORS_ORIGINS=http://localhost:3001

# Matches the credentials in infra/docker/docker-compose.yml.
# In staging/production this comes from the secret store, not a file.
DATABASE_URL=postgresql://cpe:cpe_local_dev@localhost:5432/cpe?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

LOG_LEVEL=debug

# Serves Swagger UI at /docs and the OpenAPI JSON at /docs/openapi.json.
# Keep this false in production.
SWAGGER_ENABLED=true

# --- Auth -------------------------------------------------------------------
# No default and no fallback: the API refuses to boot without this. A hardcoded
# fallback secret is one forgotten env var away from anyone being able to mint a
# SUPER_ADMIN token.
#   generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-openssl-rand-base64-48-at-least-32-chars

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --- OTP --------------------------------------------------------------------
OTP_TTL_SECONDS=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5

# Per-phone AND per-IP. Both matter: per-phone alone lets one host walk the whole
# number space; per-IP alone lets a botnet SMS-bomb one victim (and bill us for it).
OTP_MAX_REQUESTS_PER_PHONE=5
OTP_PHONE_WINDOW_SECONDS=3600
OTP_MAX_REQUESTS_PER_IP=20
OTP_IP_WINDOW_SECONDS=3600

# `console` logs the OTP instead of sending it. Dev only — the API refuses to boot
# with NODE_ENV=production and SMS_PROVIDER=console.
SMS_PROVIDER=console

# --- Delivery (Phase 3) -----------------------------------------------------
PUBLIC_BASE_URL=http://localhost:3000

# `local` writes proof-of-delivery photos to disk. Dev only — the API refuses to boot
# with NODE_ENV=production and STORAGE_PROVIDER=local, because those photos would vanish
# with the pod and there would be no way to settle a delivery dispute.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./.storage
STORAGE_SIGNED_URL_TTL_SECONDS=300
DELIVERY_PHOTO_MAX_BYTES=5242880

# The nightly planner. 21:00: late enough that the day's subscription changes have
# settled, early enough that ops can look at the unassigned list before the 5am round.
DELIVERY_PLANNER_CRON=0 21 * * *
DELIVERY_PLANNER_ENABLED=true

# --- Wallet maintenance (Phase 5 hardening) ---------------------------------
# Replays every wallet's ledger nightly and ALERTS on a mismatch. Nobody thinks to ask
# about the wallet that is quietly wrong, so something has to ask on their behalf.
WALLET_RECONCILE_CRON=0 2 * * *
WALLET_MAINTENANCE_ENABLED=true
# Idempotency keys are replay protection, not an audit trail (the ledger is that).
IDEMPOTENCY_RETENTION_HOURS=24

# --- Recycling & batching (Phase 5) -----------------------------------------
BATCHING_CRON=0 4 * * *
BATCHING_ENABLED=true
# A truck to a mill costs the same whether it carries 50 kg or 500 kg, so tiny batches
# destroy the unit economics. Paper keeps fine in a warehouse.
BATCH_MIN_WEIGHT_GRAMS=50000
# Paper genuinely loses moisture in transit. A few percent is physics; a large gap is
# spillage, a mis-keyed figure, or theft — and this threshold draws that line.
WEIGHBRIDGE_TOLERANCE_PERCENT=5

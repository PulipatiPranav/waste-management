// Circular Paper Economy — database schema.
//
// Conventions:
//   - Table names are snake_case via @@map; Prisma models stay PascalCase.
//   - MONEY IS INTEGER PAISE (`Int`), never Float and never Decimal.
//
//     Paise — the smallest indivisible unit — because every money value in this system
//     eventually gets multiplied (price × issues), split (proration) or summed
//     (cashback ledger), and integers make those operations exact and associative.
//     Float is disqualified outright. Decimal would also be exact here, but it drags
//     decimal.js into the domain layer, which is meant to be framework-free, and it
//     leaves "how do we round?" as an open question at every call site. With integers
//     there is nothing to round: 450 paise × 26 issues = 11700 paise, full stop.
//
//     Rupees exist only at the presentation edge, for display. Nothing in the domain
//     or the database holds a rupee.
//
//     Use BigInt for running totals and ledger balances (Int is 32-bit — it tops out
//     at ~₹21 million, which is a plausible lifetime volume, not a safe ceiling).
//
//   - Weights are `Decimal @db.Decimal(10, 3)` (grams of precision on a kg value).
//   - Ledger tables are append-only: no updatedAt, no in-place mutation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  APARTMENT_ADMIN
  BUSINESS_ADMIN
  DELIVERY_PARTNER
  RECYCLING_PARTNER_ADMIN
  OPS_STAFF
  SUPER_ADMIN
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// E.164, e.g. +919876543210. Normalised on the way in — the same human must not
  /// be able to create two accounts by typing 9876543210 and +91 98765 43210.
  phone String  @unique
  email String? @unique
  name  String?

  /// Argon2id. Null for OTP-only accounts (every customer). Only staff and admins
  /// ever set one — see StaffLoginUseCase.
  passwordHash String?

  role Role @default(CUSTOMER)

  /// Set the first time an OTP is successfully verified for this phone.
  phoneVerifiedAt DateTime?

  /// Soft disable. A suspended user's existing tokens are rejected at the guard,
  /// so suspension takes effect immediately rather than at token expiry.
  isActive Boolean @default(true)

  addresses     Address[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]

  /// Set only for users with role DELIVERY_PARTNER.
  deliveryPartner DeliveryPartner?

  wallet          Wallet?
  pickupRequests  PickupRequest[]
  withdrawals     WithdrawalRequest[]
  idempotencyKeys IdempotencyKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Organisations. Minimal for now — Phase 7 grows these into real tenants.
// ---------------------------------------------------------------------------

model Apartment {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  verified Boolean @default(false)

  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("apartments")
}

model Business {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  verified Boolean @default(false)

  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

/// An address belongs to exactly one of a user, an apartment or a business.
///
/// Prisma has no native check constraint, so the "exactly one owner" rule is
/// enforced in SQL by the migration (`addresses_exactly_one_owner`). Leaving it to
/// application code alone means the one buggy write path that forgets it silently
/// creates an orphaned or double-owned row, and pickups get routed nowhere.
model Address {
  id String @id @default(uuid()) @db.Uuid

  /// Free-text tag the customer sees: "Home", "Office".
  label String?

  line1    String
  line2    String?
  city     String
  state    String
  pincode  String
  country  String  @default("IN")
  landmark String?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// The default pickup/delivery address for its owner. At most one per owner is
  /// enforced in the repository, not the DB — partial unique indexes across three
  /// nullable owner columns are more trouble than they are worth here.
  isDefault Boolean @default(false)

  userId      String? @db.Uuid
  apartmentId String? @db.Uuid
  businessId  String? @db.Uuid

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  business  Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// onDelete: Restrict on the far side — an address with a live subscription pointing
  /// at it cannot be deleted out from under the delivery run.
  subscriptions  Subscription[]
  deliveryStops  DeliveryStop[]
  pickupRequests PickupRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([apartmentId])
  @@index([businessId])
  @@index([pincode])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum OtpPurpose {
  LOGIN
}

/// A single OTP challenge.
///
/// The code itself is NEVER stored or logged in plaintext — only `codeHash`
/// (Argon2id). A six-digit code is trivially brute-forced from a leaked table if it
/// is hashed with something fast, so the slow hash is doing real work here even
/// though the code is short-lived.
model OtpChallenge {
  id String @id @default(uuid()) @db.Uuid

  phone    String
  codeHash String

  purpose OtpPurpose @default(LOGIN)

  expiresAt DateTime

  /// Set the moment the code is accepted. A non-null value makes the challenge
  /// single-use: VerifyOtpUseCase refuses a consumed challenge even if the code and
  /// the expiry are both still valid.
  consumedAt DateTime?

  /// Wrong guesses so far. At the configured maximum the challenge is dead, which
  /// caps an online brute force at a handful of tries regardless of rate limiting.
  attempts Int @default(0)

  /// For abuse forensics. Not used for rate limiting — that is Redis.
  requestIp String?

  createdAt DateTime @default(now())

  /// Verification looks up the newest live challenge for a phone.
  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// A refresh token, stored only as a SHA-256 hash.
///
/// SHA-256 rather than Argon2 on purpose: unlike a 6-digit OTP, the token is 256
/// bits of CSPRNG output, so there is no dictionary to grind and a slow hash buys
/// nothing while costing latency on every refresh.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  /// All tokens descended from one login share a family id.
  ///
  /// This is what makes theft detectable: rotation revokes each token as it is
  /// exchanged, so if a *already-revoked* token is ever presented again, either the
  /// legitimate client or an attacker is replaying a stolen one. We cannot tell
  /// which, so the whole family is revoked and both are forced to log in again.
  family String @db.Uuid

  expiresAt DateTime
  revokedAt DateTime?

  /// The token this one was rotated into. Purely for auditing a family's chain.
  replacedByTokenId String? @db.Uuid

  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum Language {
  ENGLISH
  HINDI
  KANNADA
  TAMIL
  TELUGU
  MALAYALAM
  MARATHI
  BENGALI
  GUJARATI
  URDU
  PUNJABI
  ODIA
}

model Publisher {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  website  String?
  isActive Boolean @default(true)

  newspapers Newspaper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("publishers")
}

model Newspaper {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  language      Language
  coverImageUrl String?

  publisherId String    @db.Uuid
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)

  /// Soft availability switch. Catalog rows are never hard-deleted once a Subscription
  /// has ever pointed at them — see the onDelete: Restrict on editions.
  isActive Boolean @default(true)

  editions NewspaperEdition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The same masthead can publish in several languages; the pair is what is unique.
  @@unique([publisherId, name, language])
  @@index([language])
  @@map("newspapers")
}

/// A newspaper as sold in one city: its own price and its own delivery footprint.
///
/// The edition — not the newspaper — is what a customer subscribes to, because The
/// Hindu in Bengaluru and The Hindu in Chennai are different products with different
/// prices and different serviceable pincodes.
model NewspaperEdition {
  id String @id @default(uuid()) @db.Uuid

  newspaperId String    @db.Uuid
  newspaper   Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)

  city  String
  state String

  /// Pincodes this edition is actually delivered to. A customer whose address falls
  /// outside this list must not be able to subscribe — the van does not go there.
  servicePincodes String[]

  /// INTEGER PAISE. See the money convention at the top of this file.
  ///
  /// Price is per ISSUE, not per month. That is the whole reason proration in this
  /// system has no rounding step: a bill is `pricePerIssuePaise × issues delivered`,
  /// so a subscription that starts on the 17th is charged for exactly the issues it
  /// receives. Dividing a monthly price by days would reintroduce the rounding — and
  /// the off-by-one — that this model avoids.
  pricePerIssuePaise Int

  isAvailable Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([newspaperId, city])
  @@index([city])
  @@index([servicePincodes], type: Gin)
  @@map("newspaper_editions")
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/// Which days an issue is delivered. Drives both billing and (in Phase 3) the run sheet.
enum DeliveryFrequency {
  DAILY
  WEEKDAYS
  WEEKENDS
  SUNDAY_ONLY
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  editionId String           @db.Uuid
  edition   NewspaperEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)

  deliveryAddressId String  @db.Uuid
  deliveryAddress   Address @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)

  status    SubscriptionStatus @default(ACTIVE)
  frequency DeliveryFrequency  @default(DAILY)

  billingCycle BillingCycle @default(MONTHLY)

  /// Date-only semantics (midnight UTC). A subscription starts on a DAY, not at an
  /// instant — storing 2026-07-14T18:30:00+05:30 would make "is this day billable?"
  /// depend on the reader's timezone, and half the boundary tests would flip.
  startDate DateTime @db.Date

  /// Set when cancelled. Kept (rather than deleting the row) because the final invoice
  /// still has to be computed from it, and Phase 6's impact history reads it.
  cancelledAt DateTime?

  /// The price in force when the customer subscribed, copied off the edition.
  ///
  /// Copied, not looked up. If an admin raises the edition's price, existing
  /// subscribers must not be silently re-billed at the new rate — and every past
  /// invoice must still recompute to the same number it did when it was issued.
  pricePerIssuePaiseAtSubscription Int

  pauses        SubscriptionPause[]
  deliveryStops DeliveryStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([editionId])
  @@index([status])
  @@map("subscriptions")
}

/// One pause window. An append-only log, not a mutable pair of columns on Subscription.
///
/// Billing has to answer "which issues did this customer actually miss, in this
/// period?", and a customer who pauses twice in one month has two windows. Collapsing
/// them into `pausedAt`/`resumedAt` on the subscription row would lose the first one,
/// and the invoice would silently overcharge.
model SubscriptionPause {
  id String @id @default(uuid()) @db.Uuid

  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Inclusive: no issue is delivered on this day.
  pausedFrom DateTime @db.Date

  /// Inclusive: the first day delivery RESUMES is resumedFrom.
  /// Null means the pause is still open.
  resumedFrom DateTime? @db.Date

  createdAt DateTime @default(now())

  @@index([subscriptionId, pausedFrom])
  @@map("subscription_pauses")
}

// ---------------------------------------------------------------------------
// Delivery (Phase 3) — forward newspaper logistics only. No pickup/recycling.
// ---------------------------------------------------------------------------

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleType {
  ON_FOOT
  BICYCLE
  SCOOTER
  MOTORCYCLE
  CAR
}

/// A delivery area, defined as a list of pincodes.
///
/// Pincodes rather than polygons, deliberately: a pincode list is something an ops
/// person can edit in a form and reason about, and it joins directly against the
/// pincode already on every Address. Polygons need GIS tooling, a map UI and a
/// point-in-polygon query on the hot path of the nightly job — all to solve a problem
/// (sub-pincode granularity) we do not have yet. Documented as a future change.
model DeliveryZone {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  city String

  /// A pincode may appear in more than one zone. The assignment job resolves that
  /// deterministically and warns — see resolveZone() in the planner.
  pincodes String[]

  isActive Boolean @default(true)

  partners DeliveryPartnerZone[]
  runs     DailyDeliveryRun[]
  batches  CollectionBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([pincodes], type: Gin)
  @@map("delivery_zones")
}

model DeliveryPartner {
  id String @id @default(uuid()) @db.Uuid

  /// One partner profile per user. The user's role must be DELIVERY_PARTNER; that is
  /// enforced in the onboarding use case, and the guard reads the role from the DB.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kycStatus   KycStatus   @default(PENDING)
  vehicleType VehicleType @default(BICYCLE)

  /// Ops kill-switch. An offboarded partner keeps their history but is never assigned
  /// new work — which is why assignment filters on this rather than deleting the row.
  isActive Boolean @default(true)

  /// Self-declared "I am working tomorrow". Distinct from isActive: a partner on leave
  /// is unavailable but very much still onboarded.
  isAvailable Boolean @default(true)

  zones   DeliveryPartnerZone[]
  runs    DailyDeliveryRun[]
  pickups PickupRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kycStatus])
  @@map("delivery_partners")
}

/// Explicit join table: a partner can work several zones, a zone has several partners.
model DeliveryPartnerZone {
  partnerId String          @db.Uuid
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  zoneId String       @db.Uuid
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([partnerId, zoneId])
  @@index([zoneId])
  @@map("delivery_partner_zones")
}

enum RunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// One partner's work for one zone on one day.
model DailyDeliveryRun {
  id String @id @default(uuid()) @db.Uuid

  /// Date-only, like Subscription.startDate. A run belongs to a DAY, not an instant —
  /// see the Day value object for why an instant would make "today" reader-dependent.
  runDate DateTime @db.Date

  partnerId String          @db.Uuid
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  zoneId String       @db.Uuid
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  status RunStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?

  stops   DeliveryStop[]
  pickups PickupRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One run per partner per zone per day. This is what makes the nightly job
  /// idempotent: a re-run (a retry, a manual kick, two workers racing) collides here
  /// instead of quietly issuing a partner a second, duplicate run sheet.
  @@unique([runDate, partnerId, zoneId])
  @@index([runDate, status])
  @@map("daily_delivery_runs")
}

enum StopStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

/// One subscription's delivery, on one day. The unit of work the partner actually acts on.
model DeliveryStop {
  id String @id @default(uuid()) @db.Uuid

  runId String           @db.Uuid
  run   DailyDeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  /// Snapshotted from the subscription at planning time.
  ///
  /// A customer who changes their delivery address at 6am must not silently re-route a
  /// run sheet the partner already has on their phone and is halfway through. The
  /// change takes effect on the NEXT run, which is also what the partner expects.
  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  status StopStatus @default(PENDING)

  /// Required for FAILED and SKIPPED, forbidden for DELIVERED — enforced in the domain.
  /// "Failed" with no reason is a support ticket nobody can answer.
  reason String?

  /// Object key, not a URL. URLs expire, buckets get renamed, and CDNs change; the key
  /// is the stable identity. The StorageProvider mints a signed URL on read.
  photoKey String?

  /// Sequence within the run. Insertion order for now — route optimisation is a
  /// documented future enhancement (see the planner), NOT built here.
  sequence Int

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A subscription gets at most ONE stop per run. Belt-and-braces against a planner
  /// bug double-adding a customer whose pincode falls in two overlapping zones.
  @@unique([runId, subscriptionId])
  @@index([runId, sequence])
  @@index([status])
  @@map("delivery_stops")
}

// ---------------------------------------------------------------------------
// Pickup, weighing, wallet & cashback (Phase 4) — the circular-economy loop.
//
// This is the money path. Three rules hold everywhere below:
//
//   1. WEIGHT IS INTEGER GRAMS. Same reasoning as money-in-paise: the smallest
//      indivisible unit, so nothing accumulates float error on the way to a rupee.
//
//   2. THE LEDGER IS APPEND-ONLY. A WalletTransaction is never updated or deleted
//      after insert — enforced by a trigger, not merely by convention. A wallet you
//      cannot reconstruct from its ledger is a wallet you cannot defend in a dispute.
//
//   3. THE WALLET BALANCE IS A CACHE OF THE LEDGER. `wallets.balancePaise` exists so
//      a read does not have to sum a million rows, but the ledger is the truth. There
//      is a test asserting balance == sum(ledger) after every operation.
// ---------------------------------------------------------------------------

enum PaperType {
  NEWSPAPER
  MAGAZINE
  OFFICE_PAPER
  CARDBOARD
  OTHER
}

/// A versioned price list. Exactly one is ACTIVE at a time.
///
/// Versioned rather than mutable: a PickupItem records the rate that applied at the
/// moment it was weighed (`ratePerKgPaiseAtPickup`), so an admin changing today's rate
/// can never retroactively change what a customer was paid last month. Recomputing
/// history from a mutable rate table is how a cashback ledger stops reconciling.
model RateCard {
  id   String @id @default(uuid()) @db.Uuid
  name String

  /// Only one card may be active. Enforced by a partial unique index in the migration.
  isActive Boolean @default(false)

  /// Null while active; set when superseded. Kept for audit.
  retiredAt DateTime?

  items       RateCardItem[]
  pickupItems PickupItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("rate_cards")
}

model RateCardItem {
  id String @id @default(uuid()) @db.Uuid

  rateCardId String   @db.Uuid
  rateCard   RateCard @relation(fields: [rateCardId], references: [id], onDelete: Cascade)

  paperType PaperType

  /// INTEGER PAISE per kilogram. e.g. 1500 = ₹15.00/kg.
  ratePerKgPaise Int

  @@unique([rateCardId, paperType])
  @@map("rate_card_items")
}

enum PickupStatus {
  REQUESTED
  ASSIGNED
  COMPLETED
  CANCELLED
}

/// A customer's request to have recyclable paper collected.
model PickupRequest {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  /// Date-only, like every other calendar concept here. See the Day value object.
  scheduledDate DateTime @db.Date

  /// The window the customer chose, e.g. 9-12. Advisory: routing is by run, not by hour.
  windowStartHour Int
  windowEndHour   Int

  status PickupStatus @default(REQUESTED)

  /// The customer shows this to the partner at the door; the partner scans it.
  ///
  /// High-entropy and UNIQUE, because scanning it is what authorises a partner to weigh
  /// against this customer's wallet. A guessable token would let anyone credit a stranger's
  /// pickup to themselves. Hashed? No — it is short-lived, single-purpose, and the partner
  /// must be able to present it verbatim; the defence is entropy plus the run-ownership
  /// check, not secrecy at rest.
  qrToken String @unique

  /// Set by the nightly planner: the run this pickup rides along with.
  runId String?           @db.Uuid
  run   DailyDeliveryRun? @relation(fields: [runId], references: [id], onDelete: SetNull)

  /// Denormalised for the partner's authorisation check on scan.
  assignedPartnerId String?          @db.Uuid
  assignedPartner   DeliveryPartner? @relation(fields: [assignedPartnerId], references: [id], onDelete: SetNull)

  items PickupItem[]

  /// The single wallet credit this pickup produced. One-to-one, and the FK is on the
  /// transaction side, so a pickup cannot be credited twice.
  walletTransaction WalletTransaction?

  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([scheduledDate, status])
  @@index([runId])
  @@map("pickup_requests")
}

/// One weighed paper type within a pickup.
model PickupItem {
  id String @id @default(uuid()) @db.Uuid

  pickupId String        @db.Uuid
  pickup   PickupRequest @relation(fields: [pickupId], references: [id], onDelete: Cascade)

  paperType PaperType

  /// INTEGER GRAMS. Never a float kilogram.
  weightGrams Int

  /// SNAPSHOT. The rate in force when this was weighed — not a lookup.
  ratePerKgPaiseAtPickup Int

  /// Which card that rate came from. For audit: "why was I paid ₹12/kg in March?"
  rateCardId String   @db.Uuid
  rateCard   RateCard @relation(fields: [rateCardId], references: [id], onDelete: Restrict)

  /// THE rounded amount for this line, in paise.
  ///
  /// Stored, not derived. `weightGrams × ratePerKgPaise / 1000` is fractional in general
  /// (1235 g × 1499 p/kg = 1851.265 paise), so rounding is unavoidable — and this column
  /// is the ONE place in the money path where it happens. The wallet credit is the exact
  /// SUM of these, so the ledger always reconciles against the items and no drift can
  /// accumulate between "what we told the customer" and "what we paid".
  amountPaise Int

  createdAt DateTime @default(now())

  /// THE chain-of-custody link. Null until the batching job claims this item.
  ///
  /// An explicit FK, not an inferred join on (zone, paperType, date). Phase 6's
  /// environmental claims are only as credible as this column: "we recycled 40 tonnes" has
  /// to be answerable as a query that walks
  /// PickupItem -> CollectionBatch -> BatchDispatch -> RecyclingPartner, and an inferred
  /// link cannot survive an auditor asking "show me which mill THIS customer's newspapers
  /// went to".
  batchId String?          @db.Uuid
  batch   CollectionBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  /// One line per paper type per pickup. Two NEWSPAPER lines would double-count.
  @@unique([pickupId, paperType])
  /// Serves the batching job's scan for unbatched items, and the traceability query.
  @@index([batchId])
  @@map("pickup_items")
}

/// One wallet per user.
model Wallet {
  id String @id @default(uuid()) @db.Uuid

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// A CACHE of the ledger, in paise. BigInt because Int (32-bit) tops out around
  /// ₹21 million — a plausible lifetime volume, not a safe ceiling.
  ///
  /// Never negative: a check constraint enforces it, so an overdraw aborts the
  /// transaction rather than silently producing a customer who owes us money.
  balancePaise BigInt @default(0)

  /// INR only, but stored: a wallet without a currency is a bug waiting for expansion.
  currency String @default("INR")

  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wallets")
}

enum WalletTxnType {
  /// Cashback from a completed pickup.
  PICKUP_CASHBACK
  /// Funds reserved when a withdrawal is requested (money leaves the wallet immediately).
  WITHDRAWAL_DEBIT
  /// Reversal when ops rejects a withdrawal. A new row — never an edit of the debit.
  WITHDRAWAL_REVERSAL
  /// Manual correction by ops. Always leaves an audit trail.
  ADJUSTMENT
}

enum WalletTxnDirection {
  CREDIT
  DEBIT
}

/// THE LEDGER. Append-only, immutable, the single source of truth for the balance.
///
/// A trigger in the migration REJECTS every UPDATE and DELETE on this table. Not a
/// convention, not a code review rule — the database refuses. The one thing that must
/// never happen to a financial ledger is a row quietly changing after the fact, and
/// "we agreed not to do that" is not a control.
model WalletTransaction {
  id String @id @default(uuid()) @db.Uuid

  /// THE ORDER OF THE LEDGER. Not `createdAt`.
  ///
  /// A monotonic sequence, assigned by Postgres at INSERT — which happens while the
  /// wallet row lock is held, so per wallet the sequence order IS the commit order.
  ///
  /// `createdAt` cannot do this job, and the reason is subtle enough to be worth
  /// spelling out: `DEFAULT CURRENT_TIMESTAMP` is the TRANSACTION START time, frozen for
  /// the transaction's whole life. But a transaction that starts earlier can commit later
  /// — it waits on the wallet lock. So a correct ledger can have an entry with an earlier
  /// `createdAt` and a LATER `balanceAfter`, and replaying it in timestamp order reports a
  /// break in a perfectly sound ledger (and, in other interleavings, hides a real one).
  /// A reconciliation tool that cries wolf is worse than none, because you stop trusting
  /// it. There is a regression test that forces exactly this inversion.
  seq BigInt @unique @default(autoincrement())

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  type      WalletTxnType
  direction WalletTxnDirection

  /// Always POSITIVE. The direction says which way it moves; a signed amount would let
  /// a "negative credit" mean two different things depending on who reads it.
  amountPaise BigInt

  /// The wallet balance immediately AFTER this entry was applied.
  ///
  /// Stored so the ledger is self-verifying: read it in order and every balanceAfter must
  /// equal the previous one plus/minus this amount. That is what catches a lost update —
  /// the classic concurrency bug where two credits read the same balance and one vanishes.
  balanceAfterPaise BigInt

  /// At most one cashback transaction per pickup. THE guard against double-crediting a
  /// pickup: a replayed completion collides here, at the database, not in a code path
  /// someone might refactor around.
  pickupId String?        @unique @db.Uuid
  pickup   PickupRequest? @relation(fields: [pickupId], references: [id], onDelete: Restrict)

  withdrawalId String?            @db.Uuid
  withdrawal   WithdrawalRequest? @relation(fields: [withdrawalId], references: [id], onDelete: Restrict)

  /// Free text for ADJUSTMENT, and the rejection reason on a reversal.
  note String?

  /// Who caused this. Null for system-generated cashback.
  actorUserId String? @db.Uuid

  createdAt DateTime @default(now())

  // NOTE: no updatedAt. There is no update. See the trigger.

  /// Every ledger read orders by `seq`, so this is the index that serves them.
  @@index([walletId, seq])
  @@index([type])
  @@map("wallet_transactions")
}

enum WithdrawalStatus {
  /// Requested by the customer. Funds are ALREADY debited and held.
  REQUESTED
  /// Ops approved. Money still has to be sent by a human — see the compliance note.
  APPROVED
  /// Ops rejected; the debit has been reversed by a new CREDIT row.
  REJECTED
  /// A human confirmed the bank transfer went out.
  PAID
}

/// A request to move wallet money to a bank account.
///
/// NOTHING IS AUTO-DISBURSED. Approval is a human OPS_STAFF action, and marking a
/// payout PAID is a second, separate human action. This is deliberate and is a
/// compliance boundary, not an engineering shortcut — see the RBI PPI note in the README.
model WithdrawalRequest {
  id String @id @default(uuid()) @db.Uuid

  walletId String @db.Uuid
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  amountPaise BigInt

  status WithdrawalStatus @default(REQUESTED)

  /// Where the money is meant to go. Stored, never logged.
  ///
  /// Last 4 digits only, plus an opaque reference to whatever the payout rail needs.
  /// A full account number in this table is a liability we do not need to carry in
  /// Phase 4, where a human keys the transfer in anyway.
  bankAccountLast4 String
  bankIfsc         String
  accountHolder    String

  reviewedByUserId String?   @db.Uuid
  reviewedAt       DateTime?
  rejectionReason  String?

  /// Set when a human confirms the transfer left the bank.
  paidAt     DateTime?
  paymentRef String?

  transactions WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status, createdAt])
  @@map("withdrawal_requests")
}

/// Replay protection for non-idempotent, money-moving requests.
///
/// A delivery partner completing a pickup is standing in a doorway on a 2G connection.
/// They WILL double-submit. The client sends an `Idempotency-Key`; the first request
/// stores its response here, and a replay returns that same response instead of
/// crediting the wallet twice.
///
/// The request fingerprint is stored too: the same key with a DIFFERENT body is a client
/// bug (or an attack), and must be rejected loudly rather than silently returning the
/// wrong cached answer.
model IdempotencyKey {
  id String @id @default(uuid()) @db.Uuid

  /// Scoped to the user, so one caller cannot collide with (or probe) another's keys.
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  key String

  /// METHOD + path. A key is only meaningful for the operation it was minted for.
  endpoint String

  /// SHA-256 of the request body.
  requestHash String

  /// Null while the first request is still in flight — that is what makes a concurrent
  /// duplicate wait/fail rather than race through.
  responseStatus Int?
  responseBody   Json?

  createdAt DateTime @default(now())

  @@unique([userId, key, endpoint])
  @@index([createdAt])
  @@map("idempotency_keys")
}

// ---------------------------------------------------------------------------
// Recycling partners & chain of custody (Phase 5)
//
// The FK chain is the product:
//
//   PickupItem -> CollectionBatch -> BatchDispatch -> RecyclingPartner confirmation
//
// Every gram a customer hands over must be traceable, forwards and backwards, along that
// chain. It is made of explicit foreign keys and explicit status enums — never inferred
// from a timestamp or a join on a name — because Phase 6's environmental claims are only
// as credible as this chain. "We recycled 40 tonnes" is a number an ESG auditor will ask
// you to substantiate, and the answer has to be a query, not an assertion.
// ---------------------------------------------------------------------------

enum RecyclingPartnerStatus {
  /// Onboarded, not yet verified. Never receives a dispatch.
  PENDING
  VERIFIED
  /// Failed verification, or offboarded. Keeps its history; receives nothing new.
  SUSPENDED
}

/// A mill or recycler that takes the collected paper.
model RecyclingPartner {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  status RecyclingPartnerStatus @default(PENDING)

  /// Which paper types this mill actually accepts. A cardboard-only recycler must never be
  /// sent a batch of magazines — the truck arrives and is turned away.
  acceptedPaperTypes PaperType[]

  /// Daily intake ceiling, in grams. Advisory in this phase (the batching job warns rather
  /// than refuses), because a mill that is briefly over capacity still takes the load —
  /// but it is recorded so Phase 6 can plan against it.
  dailyCapacityGrams Int

  city    String
  state   String
  pincode String

  /// For the transporter, and for the audit trail. Not a formatted address: a mill is a
  /// gate on a road, and the driver needs what the driver needs.
  addressLine String

  /// Business identifiers. Stored because an ESG auditor will ask who received the paper,
  /// and "a recycler in Bengaluru" is not an answer.
  gstin            String?
  pollutionBoardId String?

  contactName  String
  contactPhone String

  verifiedAt       DateTime?
  verifiedByUserId String?   @db.Uuid

  dispatches BatchDispatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city])
  @@map("recycling_partners")
}

enum BatchStatus {
  /// Accumulating pickups. Items can still join.
  OPEN
  /// Closed and ready to go. No more items; nothing dispatched yet.
  READY
  /// Handed to a transporter. See BatchDispatch.
  DISPATCHED
  /// The mill confirmed receipt at their weighbridge. Terminal.
  CONFIRMED
}

/// Paper of ONE type, from ONE zone, aggregated for transport to a mill.
///
/// Grouped by (zone, paperType) because that is what a mill buys: a truck of mixed
/// cardboard and newsprint is two products in one load, and the mill weighs and prices them
/// separately anyway. Grouping is deliberately simple — nearest-mill routing, load
/// consolidation across zones, and capacity-aware packing are all real optimisations and
/// none of them are built here. Say so out loud rather than pretending otherwise.
model CollectionBatch {
  id String @id @default(uuid()) @db.Uuid

  /// Human-readable, for the paperwork a driver physically carries.
  reference String @unique

  zoneId String       @db.Uuid
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  paperType PaperType

  status BatchStatus @default(OPEN)

  /// The sum of its items' weights, in grams, as WE weighed them at customers' doors.
  ///
  /// Denormalised so a batch can be read without summing its items, but it is a CACHE of
  /// exactly that sum — the same relationship the wallet balance has to the ledger. It is
  /// recomputed inside the transaction that adds items, never adjusted by hand.
  ///
  /// This is the number the weighbridge is compared against. It is NEVER overwritten by
  /// what the mill reports: a discrepancy is recorded as a discrepancy, because the moment
  /// you overwrite your own measurement with the counterparty's, you have destroyed the
  /// evidence that there was a difference at all.
  collectedWeightGrams Int @default(0)

  itemCount Int @default(0)

  items    PickupItem[]
  dispatch BatchDispatch?

  closedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// At most one OPEN batch per (zone, paperType) — enforced by a partial unique index in
  /// the migration. Two open batches for the same paper in the same zone would split a
  /// load arbitrarily depending on which row a query returned first.
  @@index([zoneId, paperType, status])
  @@index([status])
  @@map("collection_batches")
}

enum DispatchStatus {
  /// On a truck. Weight at destination not yet known.
  IN_TRANSIT
  /// The mill weighed it and confirmed. Terminal.
  CONFIRMED
  /// The mill refused the load (wrong paper type, contamination, capacity).
  REJECTED
}

/// The handoff: one batch, one truck, one mill.
model BatchDispatch {
  id String @id @default(uuid()) @db.Uuid

  /// One dispatch per batch. A batch that has been sent cannot be sent again.
  batchId String          @unique @db.Uuid
  batch   CollectionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  partnerId String           @db.Uuid
  partner   RecyclingPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  status DispatchStatus @default(IN_TRANSIT)

  dispatchedAt DateTime @default(now())

  /// Who physically moved it. An ESG auditor asks; "a truck" is not an answer.
  transporterName      String
  transporterVehicleNo String
  transporterContact   String

  /// What the MILL's weighbridge said, in grams. Null until they confirm.
  ///
  /// Recorded ALONGSIDE the batch's collectedWeightGrams, never on top of it. Both numbers
  /// are real measurements taken by different parties with different instruments, and the
  /// gap between them is itself the finding — spillage, moisture loss, a mis-keyed figure,
  /// or theft. Overwrite one with the other and you have thrown away the only evidence that
  /// anything happened.
  confirmedWeightGrams Int?

  /// confirmedWeightGrams - collectedWeightGrams. Negative = the mill received LESS than we
  /// sent (the usual direction: moisture and spillage).
  ///
  /// Stored rather than derived, so it is indexable and a report can ask "show me every
  /// dispatch that lost more than 10%" without recomputing across the whole table.
  discrepancyGrams Int?

  /// Signed, in basis points of the collected weight (-250 = the load arrived 2.5% light).
  /// Basis points rather than a float percentage, for the same reason money is in paise.
  discrepancyBps Int?

  /// True when the gap exceeds WEIGHBRIDGE_TOLERANCE_PERCENT. A few percent is physics; a
  /// large gap is an incident and a human needs to look at it.
  discrepancyFlagged Boolean @default(false)

  confirmedAt       DateTime?
  confirmedByUserId String?   @db.Uuid

  rejectionReason String?

  /// The mill's own docket number. The physical paper trail behind the digital one.
  weighbridgeSlipRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, dispatchedAt])
  @@index([status])
  @@index([discrepancyFlagged])
  @@map("batch_dispatches")
}

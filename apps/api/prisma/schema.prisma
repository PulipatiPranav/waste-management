// Circular Paper Economy — database schema.
//
// Conventions:
//   - Table names are snake_case via @@map; Prisma models stay PascalCase.
//   - MONEY IS INTEGER PAISE (`Int`), never Float and never Decimal.
//
//     Paise — the smallest indivisible unit — because every money value in this system
//     eventually gets multiplied (price × issues), split (proration) or summed
//     (cashback ledger), and integers make those operations exact and associative.
//     Float is disqualified outright. Decimal would also be exact here, but it drags
//     decimal.js into the domain layer, which is meant to be framework-free, and it
//     leaves "how do we round?" as an open question at every call site. With integers
//     there is nothing to round: 450 paise × 26 issues = 11700 paise, full stop.
//
//     Rupees exist only at the presentation edge, for display. Nothing in the domain
//     or the database holds a rupee.
//
//     Use BigInt for running totals and ledger balances (Int is 32-bit — it tops out
//     at ~₹21 million, which is a plausible lifetime volume, not a safe ceiling).
//
//   - Weights are `Decimal @db.Decimal(10, 3)` (grams of precision on a kg value).
//   - Ledger tables are append-only: no updatedAt, no in-place mutation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum Role {
  CUSTOMER
  APARTMENT_ADMIN
  BUSINESS_ADMIN
  DELIVERY_PARTNER
  RECYCLING_PARTNER_ADMIN
  OPS_STAFF
  SUPER_ADMIN
}

model User {
  id String @id @default(uuid()) @db.Uuid

  /// E.164, e.g. +919876543210. Normalised on the way in — the same human must not
  /// be able to create two accounts by typing 9876543210 and +91 98765 43210.
  phone String  @unique
  email String? @unique
  name  String?

  /// Argon2id. Null for OTP-only accounts (every customer). Only staff and admins
  /// ever set one — see StaffLoginUseCase.
  passwordHash String?

  role Role @default(CUSTOMER)

  /// Set the first time an OTP is successfully verified for this phone.
  phoneVerifiedAt DateTime?

  /// Soft disable. A suspended user's existing tokens are rejected at the guard,
  /// so suspension takes effect immediately rather than at token expiry.
  isActive Boolean @default(true)

  addresses     Address[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]

  /// Set only for users with role DELIVERY_PARTNER.
  deliveryPartner DeliveryPartner?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Organisations. Minimal for now — Phase 7 grows these into real tenants.
// ---------------------------------------------------------------------------

model Apartment {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  verified Boolean @default(false)

  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("apartments")
}

model Business {
  id       String  @id @default(uuid()) @db.Uuid
  name     String
  verified Boolean @default(false)

  addresses Address[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("businesses")
}

// ---------------------------------------------------------------------------
// Addresses
// ---------------------------------------------------------------------------

/// An address belongs to exactly one of a user, an apartment or a business.
///
/// Prisma has no native check constraint, so the "exactly one owner" rule is
/// enforced in SQL by the migration (`addresses_exactly_one_owner`). Leaving it to
/// application code alone means the one buggy write path that forgets it silently
/// creates an orphaned or double-owned row, and pickups get routed nowhere.
model Address {
  id String @id @default(uuid()) @db.Uuid

  /// Free-text tag the customer sees: "Home", "Office".
  label String?

  line1    String
  line2    String?
  city     String
  state    String
  pincode  String
  country  String  @default("IN")
  landmark String?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// The default pickup/delivery address for its owner. At most one per owner is
  /// enforced in the repository, not the DB — partial unique indexes across three
  /// nullable owner columns are more trouble than they are worth here.
  isDefault Boolean @default(false)

  userId      String? @db.Uuid
  apartmentId String? @db.Uuid
  businessId  String? @db.Uuid

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  apartment Apartment? @relation(fields: [apartmentId], references: [id], onDelete: Cascade)
  business  Business?  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  /// onDelete: Restrict on the far side — an address with a live subscription pointing
  /// at it cannot be deleted out from under the delivery run.
  subscriptions  Subscription[]
  deliveryStops  DeliveryStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([apartmentId])
  @@index([businessId])
  @@index([pincode])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

enum OtpPurpose {
  LOGIN
}

/// A single OTP challenge.
///
/// The code itself is NEVER stored or logged in plaintext — only `codeHash`
/// (Argon2id). A six-digit code is trivially brute-forced from a leaked table if it
/// is hashed with something fast, so the slow hash is doing real work here even
/// though the code is short-lived.
model OtpChallenge {
  id String @id @default(uuid()) @db.Uuid

  phone    String
  codeHash String

  purpose OtpPurpose @default(LOGIN)

  expiresAt DateTime

  /// Set the moment the code is accepted. A non-null value makes the challenge
  /// single-use: VerifyOtpUseCase refuses a consumed challenge even if the code and
  /// the expiry are both still valid.
  consumedAt DateTime?

  /// Wrong guesses so far. At the configured maximum the challenge is dead, which
  /// caps an online brute force at a handful of tries regardless of rate limiting.
  attempts Int @default(0)

  /// For abuse forensics. Not used for rate limiting — that is Redis.
  requestIp String?

  createdAt DateTime @default(now())

  /// Verification looks up the newest live challenge for a phone.
  @@index([phone, createdAt])
  @@map("otp_challenges")
}

/// A refresh token, stored only as a SHA-256 hash.
///
/// SHA-256 rather than Argon2 on purpose: unlike a 6-digit OTP, the token is 256
/// bits of CSPRNG output, so there is no dictionary to grind and a slow hash buys
/// nothing while costing latency on every refresh.
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  /// All tokens descended from one login share a family id.
  ///
  /// This is what makes theft detectable: rotation revokes each token as it is
  /// exchanged, so if a *already-revoked* token is ever presented again, either the
  /// legitimate client or an attacker is replaying a stolen one. We cannot tell
  /// which, so the whole family is revoked and both are forced to log in again.
  family String @db.Uuid

  expiresAt DateTime
  revokedAt DateTime?

  /// The token this one was rotated into. Purely for auditing a family's chain.
  replacedByTokenId String? @db.Uuid

  userAgent String?
  ip        String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([family])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

enum Language {
  ENGLISH
  HINDI
  KANNADA
  TAMIL
  TELUGU
  MALAYALAM
  MARATHI
  BENGALI
  GUJARATI
  URDU
  PUNJABI
  ODIA
}

model Publisher {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  website  String?
  isActive Boolean @default(true)

  newspapers Newspaper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("publishers")
}

model Newspaper {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  language      Language
  coverImageUrl String?

  publisherId String    @db.Uuid
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Restrict)

  /// Soft availability switch. Catalog rows are never hard-deleted once a Subscription
  /// has ever pointed at them — see the onDelete: Restrict on editions.
  isActive Boolean @default(true)

  editions NewspaperEdition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The same masthead can publish in several languages; the pair is what is unique.
  @@unique([publisherId, name, language])
  @@index([language])
  @@map("newspapers")
}

/// A newspaper as sold in one city: its own price and its own delivery footprint.
///
/// The edition — not the newspaper — is what a customer subscribes to, because The
/// Hindu in Bengaluru and The Hindu in Chennai are different products with different
/// prices and different serviceable pincodes.
model NewspaperEdition {
  id String @id @default(uuid()) @db.Uuid

  newspaperId String    @db.Uuid
  newspaper   Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)

  city  String
  state String

  /// Pincodes this edition is actually delivered to. A customer whose address falls
  /// outside this list must not be able to subscribe — the van does not go there.
  servicePincodes String[]

  /// INTEGER PAISE. See the money convention at the top of this file.
  ///
  /// Price is per ISSUE, not per month. That is the whole reason proration in this
  /// system has no rounding step: a bill is `pricePerIssuePaise × issues delivered`,
  /// so a subscription that starts on the 17th is charged for exactly the issues it
  /// receives. Dividing a monthly price by days would reintroduce the rounding — and
  /// the off-by-one — that this model avoids.
  pricePerIssuePaise Int

  isAvailable Boolean @default(true)

  subscriptions Subscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([newspaperId, city])
  @@index([city])
  @@index([servicePincodes], type: Gin)
  @@map("newspaper_editions")
}

// ---------------------------------------------------------------------------
// Subscriptions
// ---------------------------------------------------------------------------

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

/// Which days an issue is delivered. Drives both billing and (in Phase 3) the run sheet.
enum DeliveryFrequency {
  DAILY
  WEEKDAYS
  WEEKENDS
  SUNDAY_ONLY
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
}

model Subscription {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  editionId String           @db.Uuid
  edition   NewspaperEdition @relation(fields: [editionId], references: [id], onDelete: Restrict)

  deliveryAddressId String  @db.Uuid
  deliveryAddress   Address @relation(fields: [deliveryAddressId], references: [id], onDelete: Restrict)

  status    SubscriptionStatus @default(ACTIVE)
  frequency DeliveryFrequency  @default(DAILY)

  billingCycle BillingCycle @default(MONTHLY)

  /// Date-only semantics (midnight UTC). A subscription starts on a DAY, not at an
  /// instant — storing 2026-07-14T18:30:00+05:30 would make "is this day billable?"
  /// depend on the reader's timezone, and half the boundary tests would flip.
  startDate DateTime @db.Date

  /// Set when cancelled. Kept (rather than deleting the row) because the final invoice
  /// still has to be computed from it, and Phase 6's impact history reads it.
  cancelledAt DateTime?

  /// The price in force when the customer subscribed, copied off the edition.
  ///
  /// Copied, not looked up. If an admin raises the edition's price, existing
  /// subscribers must not be silently re-billed at the new rate — and every past
  /// invoice must still recompute to the same number it did when it was issued.
  pricePerIssuePaiseAtSubscription Int

  pauses        SubscriptionPause[]
  deliveryStops DeliveryStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([editionId])
  @@index([status])
  @@map("subscriptions")
}

/// One pause window. An append-only log, not a mutable pair of columns on Subscription.
///
/// Billing has to answer "which issues did this customer actually miss, in this
/// period?", and a customer who pauses twice in one month has two windows. Collapsing
/// them into `pausedAt`/`resumedAt` on the subscription row would lose the first one,
/// and the invoice would silently overcharge.
model SubscriptionPause {
  id String @id @default(uuid()) @db.Uuid

  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// Inclusive: no issue is delivered on this day.
  pausedFrom DateTime @db.Date

  /// Inclusive: the first day delivery RESUMES is resumedFrom.
  /// Null means the pause is still open.
  resumedFrom DateTime? @db.Date

  createdAt DateTime @default(now())

  @@index([subscriptionId, pausedFrom])
  @@map("subscription_pauses")
}

// ---------------------------------------------------------------------------
// Delivery (Phase 3) — forward newspaper logistics only. No pickup/recycling.
// ---------------------------------------------------------------------------

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VehicleType {
  ON_FOOT
  BICYCLE
  SCOOTER
  MOTORCYCLE
  CAR
}

/// A delivery area, defined as a list of pincodes.
///
/// Pincodes rather than polygons, deliberately: a pincode list is something an ops
/// person can edit in a form and reason about, and it joins directly against the
/// pincode already on every Address. Polygons need GIS tooling, a map UI and a
/// point-in-polygon query on the hot path of the nightly job — all to solve a problem
/// (sub-pincode granularity) we do not have yet. Documented as a future change.
model DeliveryZone {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique
  city String

  /// A pincode may appear in more than one zone. The assignment job resolves that
  /// deterministically and warns — see resolveZone() in the planner.
  pincodes String[]

  isActive Boolean @default(true)

  partners DeliveryPartnerZone[]
  runs     DailyDeliveryRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([city])
  @@index([pincodes], type: Gin)
  @@map("delivery_zones")
}

model DeliveryPartner {
  id String @id @default(uuid()) @db.Uuid

  /// One partner profile per user. The user's role must be DELIVERY_PARTNER; that is
  /// enforced in the onboarding use case, and the guard reads the role from the DB.
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  kycStatus   KycStatus   @default(PENDING)
  vehicleType VehicleType @default(BICYCLE)

  /// Ops kill-switch. An offboarded partner keeps their history but is never assigned
  /// new work — which is why assignment filters on this rather than deleting the row.
  isActive Boolean @default(true)

  /// Self-declared "I am working tomorrow". Distinct from isActive: a partner on leave
  /// is unavailable but very much still onboarded.
  isAvailable Boolean @default(true)

  zones DeliveryPartnerZone[]
  runs  DailyDeliveryRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kycStatus])
  @@map("delivery_partners")
}

/// Explicit join table: a partner can work several zones, a zone has several partners.
model DeliveryPartnerZone {
  partnerId String          @db.Uuid
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  zoneId String       @db.Uuid
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([partnerId, zoneId])
  @@index([zoneId])
  @@map("delivery_partner_zones")
}

enum RunStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// One partner's work for one zone on one day.
model DailyDeliveryRun {
  id String @id @default(uuid()) @db.Uuid

  /// Date-only, like Subscription.startDate. A run belongs to a DAY, not an instant —
  /// see the Day value object for why an instant would make "today" reader-dependent.
  runDate DateTime @db.Date

  partnerId String          @db.Uuid
  partner   DeliveryPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  zoneId String       @db.Uuid
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  status RunStatus @default(PENDING)

  startedAt   DateTime?
  completedAt DateTime?

  stops DeliveryStop[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One run per partner per zone per day. This is what makes the nightly job
  /// idempotent: a re-run (a retry, a manual kick, two workers racing) collides here
  /// instead of quietly issuing a partner a second, duplicate run sheet.
  @@unique([runDate, partnerId, zoneId])
  @@index([runDate, status])
  @@map("daily_delivery_runs")
}

enum StopStatus {
  PENDING
  DELIVERED
  FAILED
  SKIPPED
}

/// One subscription's delivery, on one day. The unit of work the partner actually acts on.
model DeliveryStop {
  id String @id @default(uuid()) @db.Uuid

  runId String           @db.Uuid
  run   DailyDeliveryRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  /// Snapshotted from the subscription at planning time.
  ///
  /// A customer who changes their delivery address at 6am must not silently re-route a
  /// run sheet the partner already has on their phone and is halfway through. The
  /// change takes effect on the NEXT run, which is also what the partner expects.
  addressId String  @db.Uuid
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict)

  status StopStatus @default(PENDING)

  /// Required for FAILED and SKIPPED, forbidden for DELIVERED — enforced in the domain.
  /// "Failed" with no reason is a support ticket nobody can answer.
  reason String?

  /// Object key, not a URL. URLs expire, buckets get renamed, and CDNs change; the key
  /// is the stable identity. The StorageProvider mints a signed URL on read.
  photoKey String?

  /// Sequence within the run. Insertion order for now — route optimisation is a
  /// documented future enhancement (see the planner), NOT built here.
  sequence Int

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A subscription gets at most ONE stop per run. Belt-and-braces against a planner
  /// bug double-adding a customer whose pincode falls in two overlapping zones.
  @@unique([runId, subscriptionId])
  @@index([runId, sequence])
  @@index([status])
  @@map("delivery_stops")
}
